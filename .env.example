# Run once on startup. Leave CRON unset when using Railway Cron.
RUN_ON_STARTUP=true
# CRON=0 3 * * 0

# PostgreSQL example. Replace with your database connection URI.
DATABASES=postgresql://user:password@host:5432/database
# For multiple databases with independent folders, use DATABASES_JSON instead.
# DATABASES_JSON takes precedence over DATABASES.
# Keep JSON on one line without outer quotes when using Docker --env-file.
# DATABASES_JSON=[{"uri":"postgresql://user:password@host:5432/database","prefix":"backups/postgres"},{"uri":"mongodb://user:password@host:27017/database","prefix":"backups/mongo"}]
# MongoDB alternative:
# DATABASES=mongodb://user:password@host:27017/database
# DATABASES=mongodb+srv://user:password@cluster.example.com/database

# S3-compatible storage credentials. Never commit actual secrets.
AWS_ACCESS_KEY_ID=<ACCESS_KEY>
AWS_SECRET_ACCESS_KEY=<SECRET_KEY>
AWS_S3_BUCKET=<BUCKET_NAME>

# DigitalOcean Spaces example. Replace nyc3 with your region.
AWS_S3_REGION=nyc3
AWS_S3_ENDPOINT=https://nyc3.digitaloceanspaces.com

# Optional folder prefix, configured independently for each deployment.
# Leave empty to upload to the bucket root.
AWS_S3_PREFIX=backups/example

# Optional Telegram summary after each run. Set both variables to enable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
